dataset_path: LumiOpen/lingsoft-pemt-evals
dataset_name: FI_preference_5shot
tag:
  - lingsoft_pemt
  - lingsoft_pemt_fi
  - lingsoft_pemt_mcf
output_type: multiple_choice
num_fewshot: 0
doc_to_text: "{{ prompt }}"
doc_to_choice: "{{ choices }}"
doc_to_target: "{{ choices.index(completion) }}"
target_delimiter: ""
process_results: !function utils.process_results_preference
metric_list:
  - metric: acc
    aggregation: mean
    higher_is_better: true
  - metric: pair_acc
    aggregation: !function utils.agg_pair_acc
    higher_is_better: true
metadata:
  version: 1.0
